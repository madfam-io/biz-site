# Copy to <app-repo>/.cursorignore for JS/TS monorepos
node_modules/
dist/
build/
.next/
.turbo/
coverage/
**/__pycache__/
.pnpm-store/

# Secrets: this repo ships .env.example and its agent docs tell agents to edit
# .env / .env.local. Keep real env files out of the codebase index.
**/.env
**/.env.*
!**/.env.example
